# Shared LiteLLM proxy provisioned by organizers — all four models, no keys needed.
# Get your token from the table card or ask a host.
PROXY_URL=https://proxy.vibecodingnights.com
PROXY_TOKEN=vcn-attendee-XXXXXXXX

# MCP tool server endpoints (provisioned on the proxy host).
MCP_FILESYSTEM_URL=https://proxy.vibecodingnights.com/mcp/filesystem
MCP_SEARCH_URL=https://proxy.vibecodingnights.com/mcp/search
MCP_CODEGEN_URL=https://proxy.vibecodingnights.com/mcp/codegen

# Sandbox root for the filesystem tool (created automatically by setup.sh).
SANDBOX_DIR=./sandbox

# Optional: bring your own keys instead of the proxy.
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPUAI_API_KEY=
# MOONSHOT_API_KEY=
