# One key, four models, no proxy. Sign up at openrouter.ai, add credit
# (~$10 recommended — Claude Opus 4.7 dominates spend), paste below.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. OpenRouter shows your app name on its rankings page when set.
# OPENROUTER_REFERER=https://github.com/vibecodingnights/portable-harnessing
# OPENROUTER_APP_TITLE=portable-harnessing

# Optional. Free Brave Search key for the web_search tool (Tasks 2 & 3).
# Without this, web_search returns stub results — Task 1 still works fine.
# Get one at https://brave.com/search/api/ (free tier: 2000 queries/month).
# BRAVE_API_KEY=BSA...

# Sandbox root for the filesystem tool (created automatically by setup.sh).
SANDBOX_DIR=./sandbox

# Escape hatch: bring your own direct lab keys instead of OpenRouter.
# See docs/bring-your-own-model.md.
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPUAI_API_KEY=
# MOONSHOT_API_KEY=
