{
  "mcpServers": {
    "filesystem": {
      "transport": "http",
      "url": "${MCP_FILESYSTEM_URL}",
      "auth": { "type": "bearer", "token": "${PROXY_TOKEN}" },
      "scope": "${SANDBOX_DIR}"
    },
    "search": {
      "transport": "http",
      "url": "${MCP_SEARCH_URL}",
      "auth": { "type": "bearer", "token": "${PROXY_TOKEN}" },
      "rate_limit_per_minute": 30
    },
    "codegen": {
      "transport": "http",
      "url": "${MCP_CODEGEN_URL}",
      "auth": { "type": "bearer", "token": "${PROXY_TOKEN}" },
      "execution": { "timeout_s": 30, "memory_mb": 512 }
    }
  },
  "_comment": "All three MCP tool servers run on the proxy host. Local fallbacks live in harness/tools.py — same wire shape, in-process implementation."
}
